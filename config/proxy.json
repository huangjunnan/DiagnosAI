{
  "proxy": {
    "host": "0.0.0.0",
    "port": 8080,
    "log": {
      "default_level": "info",
      "loggers": {
        "main": "trace",
        "server": "info",
        "heaptrack_tool": "debug",
        "perf_tool": "off"
      },
      "sinks": {
        "console": { "enabled": true },
        "file": {
          "enabled": true,
          "path": "logs/diagnostic-proxy.log",
          "max_size": 5242880,
          "max_files": 5
        }
      }
    }
  }
}
