{
  "local-history.exclude": [
    "**/*.log",
    "**/build/**",
    "**/__pycache__/**",
    "**/.lh/**",
    "**/.history/**",
    "**/*.env"
  ],
  "files.autoSave": "onFocusChange",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.eol": "\n",
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "black-formatter.args": [
    "--line-length",
    "88"
  ]
}
